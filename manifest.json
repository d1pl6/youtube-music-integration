{
    "manifest_version": 3,
    "name": "YouTube Music URL Sender",
    "version": "1.0",
    "description": "Sends the current YouTube Music URL to PlaylistManager when requested",
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "https://music.youtube.com/*",
        "http://localhost:5000/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://music.youtube.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "icons": {
        "48": "icons/icon-48.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "youtube-music-extension@example.com"
        }
    }
}
